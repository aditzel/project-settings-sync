# Optional environment overrides read by pss. Copy to .env.local only if you need them.
# Every entry is optional; leaving a value empty behaves the same as leaving it unset.
#
# Backblaze B2 and Google OAuth credentials are not read from the environment.
# Configure them with `pss config set ...` and `pss login`; they are stored in the pss config directory.

# Base directory for pss config (config.json, auth.json). Default: ~/.config (uses <dir>/pss).
XDG_CONFIG_HOME=

# Base directory for pss local data. Default: ~/.local/share (uses <dir>/pss).
XDG_DATA_HOME=

# Any non-empty value makes `pss init` skip the JSON/YAML prompt and use the default `.env*` pattern.
CI=
